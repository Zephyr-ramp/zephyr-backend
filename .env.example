# Copy to .env, then fill in the keys with: npm run keys:generate
# Every variable is validated at startup (src/config.ts); the server refuses to start on bad config.

PORT=8080
LOG_LEVEL=info

# Public URL of this anchor. Wallets fetch $BASE_URL/.well-known/stellar.toml
BASE_URL=http://localhost:8080
# HOME_DOMAIN=localhost:8080

STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# SEP-10 challenge signer (must NOT be the distribution account)
SEP10_SIGNING_SECRET=
# Holds USDC; pays deposits and receives withdrawals. Needs a USDC trustline.
DISTRIBUTION_SECRET=
# >= 32 random characters
JWT_SECRET=

# PostgreSQL. Leave empty to use the in-memory store (testnet only; data lost on restart).
# DATABASE_URL=postgres://zephyr:zephyr@localhost:5432/zephyr

# zephyr-frontend origin. When set, /sep24/interactive/* is proxied there.
# FRONTEND_URL=http://localhost:3000

# Circle testnet USDC issuer. Mainnet: GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

DEPOSIT_MIN=1
DEPOSIT_MAX=10000
WITHDRAW_MIN=1
WITHDRAW_MAX=10000
FEE_FIXED=0.50
FEE_PERCENT=1

# mock | webhook (see docs/payment-rails.md)
PAYMENT_RAIL=mock
# RAIL_API_URL=https://api.your-bank.example/v1
# RAIL_API_KEY=
# HMAC secret for POST /webhooks/rail/:provider (>= 16 chars). Webhooks are off without it.
# RAIL_WEBHOOK_SECRET=

# Escrow withdrawals (zephyr-contracts). Testnet deployment:
# ESCROW_CONTRACT_ID=CCQCVQTYB45FXJG6BPLR4RPBMBOE4VD73MUMTDWT6Q55TXINSEBV3IOQ
# Secret of the escrow's `anchor` address (defaults to DISTRIBUTION_SECRET)
# ESCROW_ANCHOR_SECRET=
# ESCROW_TIMEOUT_LEDGERS=17280
# ESCROW_MIN_REMAINING_LEDGERS=120
# ESCROW_POLL_INTERVAL_MS=5000
# ESCROW_START_LEDGER=

RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Exposes /sandbox/* endpoints to simulate bank + on-chain events. Refused on the public network.
# Without ESCROW_CONTRACT_ID, the sandbox also simulates the escrow contract in memory.
ENABLE_SANDBOX=true
ENABLE_WITHDRAWAL_WATCHER=true
ENABLE_ESCROW_WATCHER=true
